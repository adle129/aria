# Local dev: backend runs on host (not Docker), Ollama on same machine.
# Copy to .env when using scripts/start-local.ps1 with real LLM.

DATABASE_URL=sqlite:///./data/aria_local.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text

# Holiday / no GPU: keep true. After setup_ollama.ps1: set false.
MOCK_LLM=true
MOCK_RAG=true

PROMPT_VERSION=v1
CHROMA_PATH=./backend/data/chroma_db
UPLOAD_PATH=./backend/data/uploads
OUTPUT_PATH=./backend/data/outputs
KNOWLEDGE_BASE_PATH=./backend/data/knowledge_base
TEMPLATE_PATH=./backend/data/templates

APP_VERSION=1.0.0
LOG_LEVEL=INFO

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
