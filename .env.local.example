# Local dev: backend runs on host (not Docker), Ollama on same machine.
# Copy to .env when using scripts/start-local.ps1 with real LLM.

DATABASE_URL=sqlite:///./data/aria_local.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text

# Holiday / no GPU: keep true. After setup_ollama.ps1: set false for RAG debug.
MOCK_LLM=true
MOCK_RAG=false

# DEV knowledge debug UI (local backend on host)
ARIA_UI_PROFILE=dev
KB_DEBUG_ENABLED=true
VALIDATION_CORPUS_PATH=E:/AI文档项目/RE_ 报价AI需求沟通
FEEDBACK_PATH=./backend/data/app/feedback/debug_feedback.jsonl

PROMPT_VERSION=v1
CHROMA_PATH=./backend/data/chroma_db
UPLOAD_PATH=./backend/data/uploads
OUTPUT_PATH=./backend/data/outputs
KNOWLEDGE_BASE_PATH=./backend/data/knowledge_base
TEMPLATE_PATH=./backend/data/templates

APP_VERSION=1.0.0
LOG_LEVEL=INFO

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ARIA_UI_PROFILE=dev
