# ARIA 阿里云 R1 预验证环境（GPU ECS · 模拟客户 production）
# 用法: cp .env.aliyun-staging.example .env 后执行 scripts/deploy-aliyun-staging.sh
# 机型参考: ecs.gn7i-c16g1.4xlarge（A10 24GB）+ 数据盘挂载 /data

ARIA_DATA_ROOT=/data/aria
POSTGRES_PASSWORD=change_me_before_deploy
DATABASE_URL=postgresql://aria_admin:change_me_before_deploy@postgres:5432/aria_db

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:32b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=16
MOCK_LLM=false
MOCK_RAG=false

ARIA_UI_PROFILE=r1
KB_DEBUG_ENABLED=false
TASK_WORKER_INLINE=false
KB_ASYNC_INDEX_ENABLED=true
PROMPT_VERSION=v1
RAG_SIMILARITY_THRESHOLD=0.65

AUTH_ENABLED=true
JWT_SECRET=change_me_jwt_before_deploy
JWT_EXPIRE_HOURS=8

# Staging default accounts (seeded by scripts/seed-staging-users.sh after deploy)
# Change after first login on shared environments.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ENGINEER_USERNAME=engineer
SEED_ENGINEER_PASSWORD=engineer123

DISK_WARNING_PERCENT=80
DISK_WRITE_PROTECT_PERCENT=90
DISK_MIN_FREE_BYTES=268435456

UPLOAD_MAX_ARCHIVE_BYTES=104857600
UPLOAD_MAX_ENTRIES=500
UPLOAD_MAX_SINGLE_FILE_BYTES=52428800
UPLOAD_MAX_EXPANDED_BYTES=524288000
UPLOAD_MAX_COMPRESSION_RATIO=100
UPLOAD_STREAM_CHUNK_BYTES=1048576

OLLAMA_MAX_CONCURRENT=1
OLLAMA_GLOBAL_SCHEDULING_ENABLED=true
OLLAMA_LEASE_TTL_SECONDS=30
OLLAMA_LEASE_HEARTBEAT_SECONDS=10
OLLAMA_LEASE_QUERY_WAIT_TIMEOUT_SECONDS=30
OLLAMA_LEASE_WORKER_WAIT_TIMEOUT_SECONDS=600

TASK_WORKER_POLL_SECONDS=2
TASK_JOB_AVG_SECONDS=120
TASK_MAX_QUEUE_SIZE=20
TASK_JOB_STALE_SECONDS=900

UPLOAD_PATH=/app/data/uploads
OUTPUT_PATH=/app/data/outputs
KNOWLEDGE_BASE_PATH=/app/data/knowledge_base
TEMPLATE_PATH=/app/data/templates
SAMPLES_RFQ_PATH=/app/samples/rfq

APP_VERSION=1.0.0-r1-staging
LOG_LEVEL=INFO
NEXT_PUBLIC_API_BASE_URL=/api/v1

# 国内 pip 加速（backend/worker Dockerfile.cn）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
