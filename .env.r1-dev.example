# R1 local dev — formal UI (no Demo chrome). Merge into .env for Docker start.ps1
# Shell env vars override this file in Compose — see README「AUTH 未生效」

ARIA_UI_PROFILE=r1
NEXT_PUBLIC_ARIA_UI_PROFILE=r1
KB_DEBUG_ENABLED=false

MOCK_LLM=false
MOCK_RAG=false
AUTH_ENABLED=true
JWT_SECRET=change-me-with-openssl-rand-hex-32

DATABASE_URL=postgresql://aria_admin:localdev123@localhost:5432/aria_db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b
EMBEDDING_MODEL=nomic-embed-text
TASK_WORKER_INLINE=false

KNOWLEDGE_BASE_PATH=./backend/data/knowledge_base
UPLOAD_PATH=./backend/data/uploads
OUTPUT_PATH=./backend/data/outputs
TEMPLATE_PATH=./backend/data/templates

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
