# Use standard image name; Docker Engine registry-mirrors handles CN acceleration.
# Override: docker build --build-arg BASE_IMAGE=python:3.11-slim ...
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}

WORKDIR /app

# Prefer Aliyun Debian mirrors (Aliyun ECS / CN networks). Keep apt/pip layers cacheable.
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' \
        /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' \
        /etc/apt/sources.list; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
      libpq5 \
      libreoffice-writer-nogui \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-ai.txt ./

ARG INSTALL_AI=true
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com

RUN pip install --upgrade pip setuptools wheel \
    && for attempt in 1 2 3; do \
         pip install --no-cache-dir --default-timeout=300 --retries 5 \
           -i ${PIP_INDEX_URL} --trusted-host ${PIP_TRUSTED_HOST} \
           -r requirements.txt \
           && break \
         || { if [ "$attempt" -eq 3 ]; then exit 1; fi; \
              echo "pip install requirements.txt failed (attempt $attempt), retrying in 15s..."; \
              sleep 15; }; \
       done \
    && if [ "$INSTALL_AI" = "true" ]; then \
         for attempt in 1 2 3; do \
           pip install --no-cache-dir --default-timeout=300 --retries 5 \
             -i ${PIP_INDEX_URL} --trusted-host ${PIP_TRUSTED_HOST} \
             -r requirements-ai.txt \
             && break \
           || { if [ "$attempt" -eq 3 ]; then exit 1; fi; \
                echo "pip install requirements-ai.txt failed (attempt $attempt), retrying in 15s..."; \
                sleep 15; }; \
         done; \
       fi

# Changing DEPLOY_SHA invalidates COPY app (keeps apt/pip cache). Never use --no-cache for code-only updates.
ARG DEPLOY_SHA=unknown
ARG PACKAGED_AT=
ENV DEPLOY_SHA=${DEPLOY_SHA}
ENV PACKAGED_AT=${PACKAGED_AT}
RUN printf '%s\n' "${DEPLOY_SHA}" > /app/DEPLOY_SHA \
    && printf 'deploy_sha=%s\npackaged_at=%s\n' "${DEPLOY_SHA}" "${PACKAGED_AT}" > /app/DEPLOY_STAMP.txt

COPY app ./app
COPY prompts ./prompts
COPY scripts ./scripts
COPY alembic.ini ./
COPY alembic ./alembic
COPY bootstrap_db.py ./
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
COPY data/config/dimension_baseline.v1.json /app/seed/config/dimension_baseline.v1.json

RUN mkdir -p /app/data/uploads /app/data/outputs /app/data/knowledge_base \
    /app/data/chroma_db /app/data/templates /app/data/config \
    && sed -i 's/\r$//' /app/docker-entrypoint.sh \
    && chmod +x /app/docker-entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
