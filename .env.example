# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aria_db
POSTGRES_USER=aria_admin
POSTGRES_PASSWORD=localdev123
DATABASE_URL=postgresql://aria_admin:localdev123@postgres:5432/aria_db

# Ollama (host process, not in container)
# Docker Compose: backend uses http://host.docker.internal:11434 (set in compose, not here)
# Local host dev (start-local.ps1): use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
EMBEDDING_MODEL=nomic-embed-text

# Mock switches (holiday dev: true; post-holiday / RAG debug: false)
MOCK_LLM=true
MOCK_RAG=true

# Knowledge debug UI (DEV only — see docs/R1/kb-debug-ui-spec.md)
# ARIA_UI_PROFILE=dev
# KB_DEBUG_ENABLED=true
# Host folder mounted into container as /app/data/validation_corpus (docker-compose.yml)
# VALIDATION_CORPUS_HOST=E:/AI文档项目/RE_ 报价AI需求沟通
# FEEDBACK_PATH=/app/data/app/feedback/debug_feedback.jsonl

# Paths (inside backend container)
PROMPT_VERSION=v1
CHROMA_PATH=/app/data/chroma_db
UPLOAD_PATH=/app/data/uploads
OUTPUT_PATH=/app/data/outputs
KNOWLEDGE_BASE_PATH=/app/data/knowledge_base
TEMPLATE_PATH=/app/data/templates

# App
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Optional PyPI mirror for Docker backend build (recommended in China if not using scripts/up.ps1 -Cn)
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com

# Frontend (browser calls nginx /api)
NEXT_PUBLIC_API_BASE_URL=/api/v1
