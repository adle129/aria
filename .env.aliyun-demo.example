# ARIA 阿里云远程 UI/流程体验环境（4C8G，无 GPU，不跑真实 LLM）
# 用法: cp .env.aliyun-demo.example .env 后执行 scripts/deploy-aliyun-demo.sh

POSTGRES_PASSWORD=change_me_before_deploy

DATABASE_URL=postgresql://aria_admin:change_me_before_deploy@postgres:5432/aria_db

# 体验环境：规则解析 + Mock RAG，无需 Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
EMBEDDING_MODEL=nomic-embed-text
MOCK_LLM=true
MOCK_RAG=true

PROMPT_VERSION=v1
CHROMA_PATH=/app/data/chroma_db
UPLOAD_PATH=/app/data/uploads
OUTPUT_PATH=/app/data/outputs
KNOWLEDGE_BASE_PATH=/app/data/knowledge_base
TEMPLATE_PATH=/app/data/templates

APP_VERSION=1.0.0
LOG_LEVEL=INFO

NEXT_PUBLIC_API_BASE_URL=/api/v1

# 可选：Nginx 基础认证（见 docs/aliyun-demo-deploy.md）
# DEMO_HTTP_AUTH=user:password_hash
