# app/utils/error_handler.py

from fastapi import Request
from fastapi.responses import JSONResponse
import logging

logger = logging.getLogger("aria")

async def generic_exception_handler(request: Request, exc: Exception):
    logger.error(
        f"未捕获异常 | path={request.url.path} | error={str(exc)}",
        exc_info=True
    )
    return JSONResponse(
        status_code=500,
        content={"code": 500, "msg": "服务器内部错误，请联系管理员"}
    )

# 标准错误响应格式：
# 400: {"code": 400, "msg": "仅支持 .docx 格式文件"}
# 404: {"code": 404, "msg": "任务 ID 不存在"}
# 422: {"code": 422, "msg": "参数校验失败", "detail": [...]}
# 500: {"code": 500, "msg": "服务器内部错误，请联系管理员"}
前端错误处理原则：

所有 API 调用必须有 try/catch，失败时通过 message.error() 提示
上传/生成操作必须有 loading 状态，不允许空白或无响应
