class TestRFQTextExtraction:

    def _create_test_docx(self, content: str) -> str:
        doc = Document()
        for line in content.split('\n'):
            if line.strip():
                doc.add_paragraph(line)
        tmp = tempfile.NamedTemporaryFile(suffix='.docx', delete=False)
        doc.save(tmp.name)
        return tmp.name

    def test_extract_normal_document(self):
        """正常文档应提取到文本内容"""
        from app.services.rfq_parser import RFQParser
        parser = RFQParser.__new__(RFQParser)
        file_path = self._create_test_docx("底盘集成验证\n悬架调校工作")
        try:
            result = parser.extract_text_from_docx(file_path)
            assert "底盘集成验证" in result
        finally:
